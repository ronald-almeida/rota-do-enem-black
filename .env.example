NEXUM_API_CHAT_ID=
NEXUM_API_CREDENTIAL=
# Origem autorizada, conforme a documentação Nexum.
NEXUM_API_ORIGIN=https://nexumpaybot.com
# Liberação temporária do botão para testar mesmo acima dos limites informados na autenticação.
# Não altera o valor nem os limites aplicados pela Nexum ao criar o Pix.
NEXUM_ALLOW_LIMIT_TEST=0
# Segredo de autenticação do callback e URLs de notificações (somente no servidor).
NEXUM_WEBHOOK_TOKEN=
PUSHCUT_PIX_PAID_URL=
PUSHCUT_PIX_PENDING_URL=
# Opcional: segredo separado para assinar as sessões de consulta. Não trocar durante a migração.
ORDER_SIGNING_SECRET=
PUBLIC_SITE_URL=https://rota-do-enem-black.vercel.app
# Manter apenas para consultar pedidos Atlas anteriores à migração.
ATLAS_SECRET_KEY=
